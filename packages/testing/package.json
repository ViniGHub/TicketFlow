{
  "name": "@ticketflow/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.0"
  },
  "devDependencies": {
    "@ticketflow/config": "workspace:*",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  }
}
